SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Set DATABASE_URL for PostgreSQL. Leave blank to use local SQLite.
DATABASE_URL=

# Comma-separated trusted origins, for example https://bagstore.example.com
CSRF_TRUSTED_ORIGINS=

# Store currency and default shipping fee (used by later steps)
CURRENCY_CODE=NPR
FLAT_SHIPPING_FEE=0

# Optional Google sign-in credentials from Google Cloud Console.
# Add both URLs as authorized redirect URIs in Google Cloud Console:
# http://127.0.0.1:8000/accounts/google/login/callback/
# https://neesora.com/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
