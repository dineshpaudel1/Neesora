SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Set DATABASE_URL for PostgreSQL. Leave blank to use local SQLite.
DATABASE_URL=

# Comma-separated trusted origins, for example https://bagstore.example.com
CSRF_TRUSTED_ORIGINS=

# Store currency and default shipping fee (used by later steps)
CURRENCY_CODE=NPR
FLAT_SHIPPING_FEE=0
